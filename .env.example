# ── Stripe（公開鍵: クライアント側で参照可） ──
VITE_STRIPE_PUBLIC_KEY=pk_live_xxx

# ── Stripe（秘密鍵・サーバー側のみ。VITE_ プレフィックス禁止） ──
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Firebase Admin SDK（Webhook が Firestore を更新するため必要） ──
# Firebase コンソール → プロジェクト設定 → サービスアカウント →
# 「新しい秘密鍵の生成」で取得した JSON 全体を 1 行にまとめて貼る
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN ..."}
